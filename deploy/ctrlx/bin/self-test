#!/bin/sh
set -eu
: "${SNAP:?run via snap}"
export PYTHONPATH="$SNAP/vendor:$SNAP/src"
export PYTHONDONTWRITEBYTECODE=1
# A missing crypto dependency must fail rather than silently skip tests.
exec /usr/bin/python3 -c 'import cryptography, unittest; from pathlib import Path; import os; suite=unittest.defaultTestLoader.discover(str(Path(os.environ["SNAP"])/"tests"), pattern="test_guard.py"); result=unittest.TextTestRunner(verbosity=2).run(suite); raise SystemExit(0 if result.wasSuccessful() and result.testsRun > 0 and not result.skipped else 1)'
